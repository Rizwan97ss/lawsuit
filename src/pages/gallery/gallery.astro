---
import MainLayout from "../../layouts/MainLayout.astro";
import Header from "../../components/layout/Header.astro";
import Footer from "../../components/layout/Footer.astro";
import PageHero from "../../components/common/PageHero.astro";
import { X, ChevronLeft, ChevronRight, Gavel } from "lucide-astro";
import img1700934 from "../../assets/1700934.jpg";
import img632090 from "../../assets/632090.jpg";
import img1700922 from "../../assets/1700922.jpg";
import img477132 from "../../assets/477132.jpg";
import img1700924 from "../../assets/1700924.jpg";
import img1701078 from "../../assets/1701078.jpg";

const images = [
  { src: img1700934.src, alt: "Legal consultation between attorneys" },
  { src: img632090.src,  alt: "Attorney working at desk" },
  { src: img1700922.src, alt: "Professional handshake in office" },
  { src: img477132.src,  alt: "Legal books and gavel" },
  { src: img1700924.src, alt: "Business professional client meeting" },
  { src: img1701078.src, alt: "Attorney portrait" },
];
---

<MainLayout
  title="Our Gallery"
  description="A look inside Civitas Law — our team, offices, and the people we serve. Committed to excellence in every case."
>
  <Header />
  <PageHero title="Our Gallery" />

  <section class="gallery-section">
    <div class="container">

      <!-- ── Header ─────────────────────────────────── -->
      <div class="gallery-head">
        <div class="contact-kicker">
          <span><Gavel size={16} /></span>
          <span>Firm Excellence in Focus</span>
        </div>
        <h2>A Glimpse Inside Our<br />Professional Environment</h2>
      </div>

      <!-- ── Grid ──────────────────────────────────── -->
      <div class="gallery-grid">
        {images.map((img, i) => (
          <button
            class="gallery-item"
            data-src={img.src}
            data-alt={img.alt}
            aria-label={`Open image: ${img.alt}`}
            type="button"
          >
            <img
              src={img.src}
              alt={img.alt}
              loading={i === 0 ? "eager" : "lazy"}
              decoding="async"
            />
            <div class="gallery-overlay">
              <span class="gallery-zoom" aria-hidden="true">&#x2315;</span>
            </div>
          </button>
        ))}
      </div>

    </div>
  </section>

  <!-- ── Lightbox ───────────────────────────────────── -->
  <dialog id="lightbox" class="lightbox" aria-modal="true" aria-label="Image lightbox">
    <button class="lightbox-close" id="lightboxClose" type="button" aria-label="Close lightbox"><X size={22} strokeWidth={2.5} /></button>
    <button class="lightbox-nav lightbox-prev" id="lightboxPrev" type="button" aria-label="Previous image"><ChevronLeft size={28} strokeWidth={2.5} /></button>
    <img id="lightboxImg" src="" alt="" />
    <button class="lightbox-nav lightbox-next" id="lightboxNext" type="button" aria-label="Next image"><ChevronRight size={28} strokeWidth={2.5} /></button>
  </dialog>

  <Footer />
</MainLayout>

<script>
  const items = document.querySelectorAll<HTMLButtonElement>(".gallery-item");
  const lightbox = document.getElementById("lightbox") as HTMLDialogElement | null;
  const lightboxImg = document.getElementById("lightboxImg") as HTMLImageElement | null;
  const lightboxClose = document.getElementById("lightboxClose");
  const lightboxPrev = document.getElementById("lightboxPrev");
  const lightboxNext = document.getElementById("lightboxNext");

  const gallery = Array.from(items).map((el) => ({
    src: el.dataset.src ?? "",
    alt: el.dataset.alt ?? "",
  }));
  let currentIdx = 0;

  function showImage(idx: number) {
    if (!lightboxImg) return;
    currentIdx = (idx + gallery.length) % gallery.length;
    lightboxImg.src = gallery[currentIdx].src;
    lightboxImg.alt = gallery[currentIdx].alt;
  }

  function openLightbox(idx: number) {
    if (!lightbox) return;
    showImage(idx);
    lightbox.showModal();
  }

  function closeLightbox() {
    lightbox?.close();
    if (lightboxImg) { lightboxImg.src = ""; lightboxImg.alt = ""; }
  }

  items.forEach((item, i) => {
    item.addEventListener("click", () => openLightbox(i));
  });

  lightboxClose?.addEventListener("click", closeLightbox);
  lightboxPrev?.addEventListener("click", (e) => { e.stopPropagation(); showImage(currentIdx - 1); });
  lightboxNext?.addEventListener("click", (e) => { e.stopPropagation(); showImage(currentIdx + 1); });

  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener("keydown", (e) => {
    if (!lightbox?.open) return;
    if (e.key === "Escape") closeLightbox();
    if (e.key === "ArrowLeft") showImage(currentIdx - 1);
    if (e.key === "ArrowRight") showImage(currentIdx + 1);
  });
</script>
