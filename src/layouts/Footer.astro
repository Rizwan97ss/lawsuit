---
import { Gavel } from "lucide-astro";
const links = [
  { label: "About", href: "/about" },
  { label: "Practice Areas", href: "/practice-areas" },
  { label: "Case Study", href: "/case-study" },
  { label: "Blog", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="site-footer">
  <div class="container footer__grid">
    <div>
      <a class="logo logo--footer" href="/">
        <span class="logo__mark"><Gavel size={20} /></span>
        <span>Civitas</span>
      </a>

      <p>
        Strategic legal guidance with integrity, precision, and client-first advocacy.
      </p>
    </div>

    <div>
      <h3>Quick Links</h3>
      <ul>
        {links.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h3>Practice Areas</h3>
      <ul>
        <li><a href="/practice-areas/corporate-business-law">Corporate Law</a></li>
        <li><a href="/practice-areas/family-law-mediation">Family Law</a></li>
        <li><a href="/practice-areas/personal-injury-litigation">Personal Injury</a></li>
        <li><a href="/practice-areas/criminal-defense">Criminal Defense</a></li>
      </ul>
    </div>

    <div>
      <h3>Contact</h3>
      <ul>
        <li>121 King Street, Melbourne</li>
        <li>+1 234 567 890</li>
        <li>contact@barister.netlify.app</li>
      </ul>
    </div>

    <div>
      <h3>Sitemap</h3>
      <ul>
        <li><a href="/">Home</a></li>
        <li><a href="/about">About</a></li>
        <li><a href="/attorney-profile">Attorney Profile</a></li>
        <li><a href="/practice-areas">Practice Areas</a></li>
        <li><a href="/case-study">Case Studies</a></li>
        <li><a href="/blog">Blog</a></li>
        <li><a href="/gallery/gallery">Gallery</a></li>
        <li><a href="/testimonials">Testimonials</a></li>
        <li><a href="/faq/faq">FAQ</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy/privacy">Privacy Policy</a></li>
        <li><a href="/disclaimer/disclaimer">Disclaimer</a></li>
      </ul>
    </div>
  </div>

  <div class="footer__bottom">
    <div class="container">
      <p>© {new Date().getFullYear()} Civitas Law. All rights reserved.</p>
    </div>
  </div>
</footer>